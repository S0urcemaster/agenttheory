<?xml version="1.0" encoding="UTF-8"?>

<structure name="leitstelle">
  <!-- XML-Struktur einer Leitstelle im Beispiel -->
  
  <leitstelle teil="optional">
    <!-- Die Hauptleitstelle hat kein "teil"-Attribut -->
      
    <def>Jedes Element kann als Komponente deklariert werden . Elemente außerhalb und vor des letzten y-Elements gelten als Komponenten</def>
    
    <!-- Vorwärts deklarierte, parametrisierte Komponenten . Komponenten können mit dem param-Attribut parametrisiert werden -->
    
      <!-- Beispiel z -Komponente / Ausgang -->
      <z name="BeispielZ" param="[parametername]">Beispiel mit [parametername] : jetzt der Eingabetext [input_text]</z>

      <!-- Beispiel y -Komponente / Weiche / Frage mit weitergereichtem parameter -->
      <y frage="Eine Frage" param="[parametername]">

        <!-- z Komponente mit eingesetztem Parameter -->
        <z name="BeispielZ" param="[parametername]" />

      </y>

    <!-- Haupt- Y -Element -->
    <!-- Es gibt immer genau EIN Start- Y Element pro Ebene / ausgenommen die Komponenten -->
    <!-- Der Start aller Verzweigungsbaeume ist die Hauptleitstelle <leitstelle> ohne teil-Attribut -->
    <!-- Es gibt immer genau 3 oder 4 Ausgänge pro Y- Element : a, b, ab (a und b gelten beide wenn moeglich), "weder-noch" (wie else) -->
      <y frage="Diese Frage soll geklaert werden">

        <!-- a : Genau ein a Element -->
        <a antwort="Diese Antwort fuehrt hier entlang">
          <!-- Ein Ausgang -->
          <z name="Beispielname">Beispielrueckgabetext</z>
        </a>
        
        <!-- b : Genau ein b Element -->
        <b antwort="Diese Antwort fuert dort entlang">
          <!-- Eine unidirektionele Weiterleitung -->
          <gehzu ref="Beispieldatei" />
        </b>
        
        <!-- a und b gelten gleichzeitig wenn logisch moeglich . Sonst fehlt das Element -->
        <ab antwort="Diese Antwort ist zutreffend fuer die Ueberschneidung und fuehrt in diese Richtung">
          <!-- Analog -->
        </ab>
        
        <!-- Weder-noch : genau ein sonst Element -->
        <sonst antwort="Diese Antwort fuehrt meistens zum User zurueck mit Bitte um wiederholung">
          <!-- Analog -->
        </sonst>
      </y>

  </leitstelle>

</structure>