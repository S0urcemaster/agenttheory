<?xml version="1.0" encoding="UTF-8"?>

<structure name="leitstelle">
  <!-- XML-Struktur einer Leitstelle im Beispiel -->
  
  <leitstelle teil="optional">
    <!-- Die Hauptleitstelle hat keine "teil"-Attribut -->

    <!-- var definiert eine Leitstellen- globale Variable / die in allen Teilen gueltig ist -->
    <var name="Variablenname">
      <option>Bezeichnet eine</option>
    </var>

    <!-- Es gibt immer genau EIN Y Element pro Ebene -->
    <!-- Es gibt immer genau 2 Wahlmoeglichkeiten pro Y- Element : a und a + "beide" wenn moeglich + "weder-noch" -->
    <y frage="Diese Frage soll geklaert werden">

      <!-- a : Genau ein a Element -->
      <a antwort="Diese Antwort fuehrt hier entlang">
        <!-- Ein Ausgang -->
        <z name="Beispielname">Beispielrueckgabetext</z>
      </a>
      
      <!-- b : Genau ein b Element -->
      <b antwort="Diese Antwort fuert dort entlang">
        <!-- Eine unidirektionele Weiterleitung -->
        <gehzu ref="Beispieldatei" />
      </b>
      
      <!-- a und b gelten gleichzeitig wenn logisch moeglich . Sonst fehlt das Element -->
      <ab antwort="Diese Antwort ist zutreffend fuer die Ueberschneidung und fuehrt in diese Richtung">

      </ab>
      
      <!-- Weder-noch : genau ein sonst Element -->
      <sonst antwort="Diese Antwort fuehrt meistens zum User zurueck mit Bitte um wiederholung">

      </sonst>
    </y>

  </leitstelle>

</structure>