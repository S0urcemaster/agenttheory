<?xml version="1.0" encoding="UTF-8"?>

<structure name="leitstelle">
  <!-- XML-Struktur einer Leitstelle im Beispiel -->
  
  <leitstelle teil="optional">
    <!-- Die Hauptleitstelle hat keine "teil"-Attribut -->

    <!-- var definiert eine Leitstellen- globale Variable / die in allen Teilen gültig ist -->
    <var name="Variablenname">
      <option>Bezeichnet eine</option>
    </var>

    <!-- Es gibt immer genau EIN Y Element pro Ebene -->
    <!-- Es gibt immer genau 2 Wahlmöglichkeiten pro Y- Element : a und a + "beide" wenn möglich + "weder-noch" -->
    <y frage="Diese Frage soll geklärt werden">

      <!-- a : Genau ein a Element -->
      <a antwort="Diese Antwort führt hier entlang">
        <!-- Ein Ausgang -->
        <z name="Beispielname">Beispielrückgabetext</z>
      </a>
      
      <!-- b : Genau ein b Element -->
      <b antwort="Diese Antwort fürt dort entlang">
        <!-- Eine unidirektionele Weiterleitung -->
        <gehezu ref="Beispieldatei" />
      </b>
      
      <!-- a und b gelten gleichzeitig wenn logisch möglich . Sonst fehlt das Element -->
      <ab antwort="Diese Antwort ist zutreffend für die Überschneidung und führt in diese Richtung">

      </ab>
      
      <!-- Weder-noch : genau ein sonst Element -->
      <sonst antwort="Diese Antwort führt meistens zum User zurück mit Bitte um wiederholung">

      </sonst>
    </y>

  </leitstelle>

</structure>