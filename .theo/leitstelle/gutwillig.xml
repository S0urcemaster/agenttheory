<?xml version="1.0" encoding="UTF-8"?>

<leitstelle teil="gutwillig">
  <!-- Hier ist also alles schoen fluffig -->

  <!-- Deklarationen der Ausstiegspunkte -->
  <z name="Entwicklungskontext" param="[frage-oder-anweisung]">Entwickler mit [frage-oder-anweisung] : [input_text]</z>
  <z name="Anwendungskontext" param="[frage-oder-anweisung]">User mit [frage-oder-anweisung] : [input_text]</z>
  <z name="Unschaerfe">Bitte den Benutzer : sein Anliegen zu wiederholen</z>

  <!-- Komponenten -->
  <y name="Eingabeart" frage="Betrifft die [frage-oder-anweisung] Entwicklung oder Anwendung ?" param="[frage-oder-anweisung]">

    <a antwort="Die [frage-oder-anweisung] betrifft die Entwicklung">
      <z name="Entwicklungskontext" param="[frage-oder-anweisung]" />
    </a>

    <b antwort="Die [frage-oder-anweisung] betrifft die Anwendung">
      <z name="Anwendungskontext" param="[frage-oder-anweisung]" />
    </b>

    <!-- ab faellt in sonst -->

    <sonst antwort="Die Rolle des [frage-oder-anweisung] -stellers ist unscharf">
      <z name="Unschaerfe" />
    </sonst>
  </y>

  <y frage="Ist die User Eingabe eine Frage oder eine Anweisung ?">

    <a antwort="Die Eingabe ist eine Frage">

      <y name="Eingabeart" param="Frage" />

    </a>

    <!-- Eindeutig eine Anweisung oder mehrere ohne Umschweife und ohne Zweifel -->
    <b antwort="Die Eingabe ist eine Anweisung">

      <y name="Eingabeart" param="Anweisung" />

    </b>

    <!-- Es koennen eine oder mehrere Fragen UND eine oder mehrere Anweisung identifiziert werden . Sonst nichts -->
    <ab antwort="Die User-Eingabe enthaelt Frage und Anweisung">
      <y frage="Betrifft die Kombination aus Frage und Anweisung Entwicklung oder Anwendung ?">
        <a antwort="Die Kombination betrifft die Entwicklung">
          <!-- Es ist eindeutig die Entwicklerrolle : die ein Anliegen hat -->
          <z name="Entwickler Anweisung">Entwickler mit Frage und Anweisung: [input_text]</z>
        </a>
        <b antwort="Die Kombination betrifft die Anwendung">
          <!-- Es ist eindeutig die Anwenderrolle : die sich meldet -->
          <z name="Anwender Anweisung">User mit Frage und Anweisung: [input_text]</z>
        </b>
        <!-- ab ist keine Option -->
        <sonst antwort="Die Rolle der Kombination ist unscharf">
          <z name="Was soll das">Bitte den Benutzer: sein Anliegen zu wiederholen</z>
        </sonst>
      </y>
    </ab>

    <sonst antwort="Die User-Eingabe ist unscharf">
      <y frage="Ist eine Aussage extrahierbar ?">
        <!-- Ist eine Botschaft enthalten / die keine Frage und keine Anweisung ist ? -->
        <a antwort="Die Nachricht enthaelt eine klare Aussage">
          <!-- Die Nachricht enthaelt neben weiteren Elementen eine klare Aussage -->
          <y frage="Besteht die Nachricht nur aus Aussage oder enthaelt sie weitere Elemente ?">
            <!-- Die Nachricht ist nur eine Aussage -->
            <a antwort="Die Nachricht besteht nur aus einer oder mehreren Aussagen">
              <!-- Einzelne oder mehrere Aussagen . Nur Aussagen -->
              <z name="Entwickler Anweisung">Entwickler mit Botschaft: [input_text]</z>
            </a>
            <b antwort="Die Nachricht enthaelt eine Aussage und weitere Elemente">
              <!-- Mindestens eine Aussage und weitere Elemente -->
              <z name="Anwender Anweisung">User mit Botschaft: [input_text]</z>
            </b>
            <!-- ab ist keine Option -->
            <sonst antwort="Die Aussage ist unscharf">
              <z name="Was soll das">Bitte den Benutzer: sein Anliegen zu wiederholen</z>
            </sonst>
          </y>
        </a>
        <b antwort="Die Eingabe betrifft die Anwendung">
          <!-- Es ist eindeutig die Anwenderrolle : die sich meldet -->
          <z name="Anwender Anweisung">User mit Anweisung: [input_text]</z>
        </b>
        <!-- ab ist keine Option -->
        <sonst antwort="Die Eingabe bleibt unscharf">
          <z name="Was soll das">Bitte den Benutzer: sein Anliegen zu wiederholen</z>
        </sonst>
      </y>
    </sonst>

  </y>
</leitstelle>
