<?xml version="1.0" encoding="UTF-8"?>

<!-- Der theoretische Canon
<struktur name="Canon"> beschreibt die einer Theory (der Canon ist eine Theory) zugrunde liegende Struktur
Innerhalb von <struktur> ist jedes XML-Element Teil der Strukturbeschreibung und wird nicht selbst verwendet /
 sondern die Elemente beschreiben Form, Bedeutung und erlaubte Verwendung der Canon-Theory und verschachtelter Theories
Jedes Theory-XML verwendet die im Canon definierte Struktur - auch der Canon selbst
Theories sind rekursiv - aber enden hier im Canon in diesem Verzeichnis -->
<struktur name="Canon">

  <!-- Universelle Tags koennen ueberall unterhalb von Top Level Tags auftauchen -->

    <!-- Beschreibung def Tag -->
    <def name="optionale semantische Bezeichnung">Tag zur Definition</def>

    <!-- Beschreibung definitionen Tag -->
    <definitionen name="Ein qualifizierender Name">Tag fuer Listen von def- Elementen</definitionen>

    <!-- Beschreibung ref Tag -->
    <ref name="dateiname">Tag fuer Referenzen . Diese soll gelesen und dann hier weiter fortgefahren werden</ref>

  <!-- Der Canon faengt hier schon an : seine selbst definierten Tags zu verwenden -->
  <def name="Theorie Referentialitaet">Der Canon und andere Theorien sind referentiell zu lesen / niemals quer
    Als Einstieg dient immer index.xml . Dort sind alle notwendigen Wege vorbereitet und dienen bereits einer schnellen Suche
  </def>
  
  <!-- Top Level Tags : -->
  
    <!-- Beschreibung theory tag : Eine AI Agent Theory Definition -->
    <theory name='Beispielname'>

      <def name="Beispiel">allgemeine Tags koennen ueberall vorkommen</def>

      <!-- Titel Tag -->
      <titel>Verpflichtender Titel der Theory</titel>

      <!-- Autor Tag -->
      <autor>Verpflichtender Verfasser der Theory</autor>

      <!-- morph Tag : verweist auf die aktive Morphology des Agents in diesem Projekt -->
      <morph name="Morphology-Name">Optionale Beschreibung . Verweist auf eine Datei in _morphology/</morph>

    </theory>
    
<!-- Datei Tags -->
  <!-- Root in eigener Datei -->

  <!-- glossar Tag -->
  <glossar>Der Glossar wird in einer eigenen Datei glossar.xml definiert</glossar>

  <!-- user Tag -->
  <user>Das weiss der Agent ueber den User</user>

  <!-- regeln Tag -->
  <regeln>Globale Regeln die auf abgeleitete Theories abfaerben</regeln>

  <!-- Der Teufel hat vielleicht noch ein Wort mitzureden -->
  <teufel>Nichtbeachtung hat Konsequenzen !</teufel>
  
  <!-- Eine Morphology ist ein benanntes Rollenkostuem / Mindset fuer den Agenten
   Der Agent nimmt beim Start eine Morphology an und handelt in ihrem Rahmen
   Wenn keine explizite Morphology gesetzt ist : gilt die Basis-Morphology "Standard" -->
  <morphology name="Eindeutiger Name">

    <!-- slot : eine konkrete Rollenauspraegung innerhalb der Morphology
     basis : Name einer Basis-Morphology aus _morphology/basis/ von der geerbt wird
     Ohne basis-Attribut gilt der slot als eigenstaendig -->
    <slot name="Rollenname" basis="vorhandenes anderes Morphology File">
      Beschreibung der Rolle / ihres Charakters / ihrer Verhaltensregeln
    </slot>

  </morphology>

  <!-- Ein Askpekt ist eine Definition im Frage-Antwort-Stil mit einem Set aus Antworten -->
  <!-- Minimale Ueberschneidung ist ein Prinzip - keine Bedingung -->
  <aspekt frage="Moeglichst isolierte Frage">
    <!-- Mindestens eine Antwort -->
    <antwort>Moeglichst umfassende und einzigartige Antwort</antwort>
    <antwort>Optionale /moeglichst von anderen isolierte weitere Antwort
      Fuer Praezision bilden die Antworten moeglichst keine Schnittmenge
    </antwort>
  </aspekt>

  <!-- Aspekte koennen in Unteraskpekte unterteilt sein . Es kann auch direkte Antworten geben
   / die sich aber notwendigerweise mit Teilaspekten ueberschneiden -->
  <!-- Im Idealfall findet man eine Antwort in einem Satz / die die Frage maximal
   zufriedenstellend beantwortet . Wenn das nicht reicht : muss man unterteilen -->
  <aspekt frage="Moeglichst isolierte Frage . Fragen bilden ebenso moeglichst keine Schnittmengen">
    <antwort>Diese optionale Antwort deckt in etwa die Teilaspekte ab</antwort>
    <!-- Teilaspekte bilden ebenso moeglichst keine Schnittmenge -->
    <aspekt frage="In der uebergeordneten Frage enthaltene Teilfrage">
      <antwort>Isolierte Antwort</antwort>
      <antwort>Optionale weitere Antwort</antwort>
    </aspekt>
    <aspekt frage="Weitere erforderliche Teilfrage (sonst waere es eine einzigartige Antwort)">
      <antwort>Isolierte Antwort</antwort>
      <antwort>Optionale weitere Antwort</antwort>
    </aspekt>
  
  </aspekt>

</struktur>
